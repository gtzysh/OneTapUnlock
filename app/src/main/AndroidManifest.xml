<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 【结果页短震反馈】 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 【查询贝壳找房是否已安装；Android 11+ 必须声明】 -->
    <queries>
        <package android:name="com.lianjia.beike" />
    </queries>

    <application
        android:name=".OpenDoorApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher_green_white"
        android:roundIcon="@mipmap/ic_launcher_green_white_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OneTapUnlock">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.OneTapUnlock" />

        <!-- 【五套桌面图标，同一时间只启用一个 alias】 -->
        <activity-alias
            android:name=".LauncherGreenWhite"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_green_white"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_green_white_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".LauncherDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".LauncherWhiteGreen"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_white_green"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_white_green_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".LauncherWhiteLine"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_white_line"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_white_line_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".LauncherWhiteMint"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_white_mint"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_white_mint_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- 【开门成功时盖在桌面上的黑底提示条，不进最近任务】 -->
        <activity
            android:name=".SuccessHudActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.OneTapUnlock.Hud" />

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="com.chatrobot.opendoor.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".UnlockAccessibilityService"
            android:exported="false"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
